{
  "name": "react-minibag",
  "version": "0.1.0-dev.1",
  "license": "MIT",
  "author": "John Soatra",
  "description": "A Library for React primitive elements",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/JohnSoatra/react-minibag"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build:vite": "tsc -b && vite build",
    "build:types": "rollup -c rollup.config.ts",
    "build": "npm run build:vite && npm run build:types"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@microsoft/api-extractor": "^7.58.7",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.0",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "globals": "^17.6.0",
    "rollup": "^4.60.4",
    "rollup-plugin-dts": "^6.4.1",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vite-plugin-svgr": "^5.2.0"
  },
  "keywords": [
    "react",
    "primitives",
    "elements",
    "ui",
    "components",
    "unstyled",
    "headless"
  ]
}
